# Copy to .env and choose a password. .env is read by docker compose and by the
# decision_service commands, and must never be committed.
POSTGRES_PASSWORD=choose-a-password
# Windows often reserves port 5432 for Hyper-V/WSL; 15432 is usually free.
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 ::1 first, which
# Docker doesn't listen on, and every connection then waits for a timeout.
POSTGRES_PORT=15432
STONKS_DB=postgresql://stonks:choose-a-password@127.0.0.1:15432/stonks
